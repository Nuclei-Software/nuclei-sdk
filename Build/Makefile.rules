## Target files stored in output directory
APP_TARGET_ELF := $(APP_TARGET).elf
APP_TARGET_MAP := $(APP_TARGET).map
APP_TARGET_BIN := $(APP_TARGET).bin
APP_TARGET_DUMP := $(APP_TARGET).dump
APP_TARGET_DASM := $(APP_TARGET).dasm
APP_TARGET_SREC := $(APP_TARGET).srec
APP_TARGET_HEX := $(APP_TARGET).hex
APP_TARGET_VERILOG := $(APP_TARGET).verilog
TARGET_ELF := $(APP_TARGET_ELF)

ALL_CSRCS = $(filter-out $(wildcard $(EXCLUDE_SRCS)), $(sort $(wildcard $(C_SRCS)) $(call get_csrcs, $(SRCDIRS) $(C_SRCDIRS))))
ALL_CXXSRCS = $(filter-out $(wildcard $(EXCLUDE_SRCS)), $(sort $(wildcard $(CXX_SRCS)) $(call get_cxxsrcs, $(SRCDIRS) $(CXX_SRCDIRS))))
ALL_ASMSRCS = $(filter-out $(wildcard $(EXCLUDE_SRCS)), $(sort $(wildcard $(ASM_SRCS)) $(call get_asmsrcs, $(SRCDIRS) $(ASM_SRCDIRS))))

ALL_ASM_OBJS := $(ALL_ASMSRCS:=.o)
ALL_C_OBJS := $(ALL_CSRCS:=.o)
ALL_CXX_OBJS := $(ALL_CXXSRCS:=.o)

## Object output directories: objects of sources under NUCLEI_SDK_ROOT
## go to SDK_OBJ_OUTDIR (path relative to NUCLEI_SDK_ROOT), all other
## local objects go to APP_OBJ_OUTDIR keeping their relative paths
SDK_OBJ_OUTDIR := $(OUTDIR)/_obj_sdk
APP_OBJ_OUTDIR := $(OUTDIR)/_obj_app

## Normalize a local object path so the object always lands inside
## APP_OBJ_OUTDIR, even for sources referenced outside the application
## directory via ../ (e.g. ../lib/foo.c) or by absolute paths (e.g.
## C:/lib/foo.c, ':' is invalid in Windows filenames)
## NOTE: __up__ mirrors the ../ of out-of-app sources, it is a reserved
## directory name inside APP_OBJ_OUTDIR
SANITIZED_OBJ = $(subst :,_,$(subst ../,__up__/,$(1)))

LOCAL_ASM_OBJS := $(addprefix $(APP_OBJ_OUTDIR)/,$(filter-out $(NUCLEI_SDK_ROOT)%,$(ALL_ASM_OBJS)))
LOCAL_C_OBJS := $(addprefix $(APP_OBJ_OUTDIR)/,$(filter-out $(NUCLEI_SDK_ROOT)%,$(ALL_C_OBJS)))
LOCAL_CXX_OBJS := $(addprefix $(APP_OBJ_OUTDIR)/,$(filter-out $(NUCLEI_SDK_ROOT)%,$(ALL_CXX_OBJS)))

## Local objects whose stored and original paths differ cannot use the
## pattern rules below (the pattern stem must be the source path), so
## explicit rules are generated for them
LOCAL_ASM_OBJS_ESC := $(foreach obj,$(LOCAL_ASM_OBJS),$(if $(filter-out $(obj),$(call SANITIZED_OBJ,$(obj))),$(obj)))
LOCAL_C_OBJS_ESC := $(foreach obj,$(LOCAL_C_OBJS),$(if $(filter-out $(obj),$(call SANITIZED_OBJ,$(obj))),$(obj)))
LOCAL_CXX_OBJS_ESC := $(foreach obj,$(LOCAL_CXX_OBJS),$(if $(filter-out $(obj),$(call SANITIZED_OBJ,$(obj))),$(obj)))

## Local objects stored in APP_OBJ_OUTDIR
LOCAL_ASM_OBJS_OUT := $(foreach obj,$(LOCAL_ASM_OBJS),$(call SANITIZED_OBJ,$(obj)))
LOCAL_C_OBJS_OUT := $(foreach obj,$(LOCAL_C_OBJS),$(call SANITIZED_OBJ,$(obj)))
LOCAL_CXX_OBJS_OUT := $(foreach obj,$(LOCAL_CXX_OBJS),$(call SANITIZED_OBJ,$(obj)))

SDK_ASM_OBJS := $(addprefix $(SDK_OBJ_OUTDIR)/,$(subst $(NUCLEI_SDK_ROOT)/,,$(filter $(NUCLEI_SDK_ROOT)%,$(ALL_ASM_OBJS))))
SDK_C_OBJS := $(addprefix $(SDK_OBJ_OUTDIR)/,$(subst $(NUCLEI_SDK_ROOT)/,,$(filter $(NUCLEI_SDK_ROOT)%,$(ALL_C_OBJS))))
SDK_CXX_OBJS := $(addprefix $(SDK_OBJ_OUTDIR)/,$(subst $(NUCLEI_SDK_ROOT)/,,$(filter $(NUCLEI_SDK_ROOT)%,$(ALL_CXX_OBJS))))

ALL_OBJS := $(LOCAL_ASM_OBJS_OUT) $(LOCAL_C_OBJS_OUT) $(LOCAL_CXX_OBJS_OUT)
ALL_OBJS += $(SDK_ASM_OBJS) $(SDK_C_OBJS) $(SDK_CXX_OBJS)

## Guard against object path collision, which can happen when the
## application contains a directory named __up__ and also references
## the sources outside the application directory via ../
ifneq ($(words $(sort $(ALL_OBJS))),$(words $(ALL_OBJS)))
DUP_OBJS = $(foreach obj,$(sort $(ALL_OBJS)),$(if $(filter-out 1,$(words $(filter $(obj),$(ALL_OBJS)))),$(obj)))
$(error Object path collision detected for: $(DUP_OBJS). "__up__" is a reserved directory name in the output directory for mirroring ../ of the sources outside the application directory, please rename the directory in your application)
endif

# Application Specific compilation flags control
# If APPDIRS is defined, we will collect sources in those directories
# and apply APP_* flags to them
ifneq ($(APPDIRS),)
APP_CSRCS = $(call get_csrcs, $(APPDIRS))
APP_CXXSRCS = $(call get_cxxsrcs, $(APPDIRS))
APP_ASMSRCS = $(call get_asmsrcs, $(APPDIRS))

APP_ASM_OBJS := $(foreach obj,$(addprefix $(APP_OBJ_OUTDIR)/,$(filter-out $(NUCLEI_SDK_ROOT)%,$(APP_ASMSRCS:=.o))),$(call SANITIZED_OBJ,$(obj)))
APP_C_OBJS := $(foreach obj,$(addprefix $(APP_OBJ_OUTDIR)/,$(filter-out $(NUCLEI_SDK_ROOT)%,$(APP_CSRCS:=.o))),$(call SANITIZED_OBJ,$(obj)))
APP_CXX_OBJS := $(foreach obj,$(addprefix $(APP_OBJ_OUTDIR)/,$(filter-out $(NUCLEI_SDK_ROOT)%,$(APP_CXXSRCS:=.o))),$(call SANITIZED_OBJ,$(obj)))

$(APP_C_OBJS): CFLAGS += $(_REAL_APP_CFLAGS) $(_REAL_APP_COMMON_FLAGS)
$(APP_CXX_OBJS): CXXFLAGS += $(_REAL_APP_CXXFLAGS) $(_REAL_APP_COMMON_FLAGS)
$(APP_ASM_OBJS): ASMFLAGS += $(_REAL_APP_ASMFLAGS) $(_REAL_APP_COMMON_FLAGS)
endif

ALL_DEPS := $(ALL_OBJS:=.d)
ALL_GCNOS := $(ALL_OBJS:.o=.gcno)
ALL_GCDAS := $(ALL_OBJS:.o=.gcda)
ALL_GCOVS := $(ALL_OBJS:.o=.gcov)

ALL_APP_TARGETS := $(APP_TARGET_ELF) $(APP_TARGET_MAP) $(APP_TARGET_BIN) \
	$(APP_TARGET_DUMP) $(APP_TARGET_DASM) $(APP_TARGET_SREC) $(APP_TARGET_HEX) \
	$(APP_TARGET_VERILOG)

CLEAN_OBJS += $(ALL_APP_TARGETS) gmon.out openocd.log $(wildcard $(ALL_OBJS) $(ALL_DEPS) $(ALL_GCNOS) $(ALL_GCDAS) $(ALL_GCOVS))
REAL_CLEAN_OBJS = $(subst /,$(PS), $(CLEAN_OBJS))

## Ensure the output directory of the generated target file exist
## MKD is defined in Makefile.misc, it works in both linux and windows
DIR_GUARD = @$(MKD) $(@D)

# Default goal, placed before dependency includes
all: info $(TARGET_ELF)

# include dependency files of application
ifneq ($(MAKECMDGOALS),clean)
-include $(ALL_DEPS)
endif

.PHONY: all info showflags showtoolver help bin size dasm upload run_openocd run_gdb run_qemu run_xlspike run_xlmodel run_qemu_debug run_xlspike_rbb run_xlspike_openocd clean debug

info:
	@$(ECHO) Current Configuration: TOOLCHAIN=$(TOOLCHAIN) RISCV_ARCH=$(RISCV_ARCH) RISCV_ABI=$(RISCV_ABI) RISCV_TUNE=$(RISCV_TUNE) RISCV_CMODEL=$(RISCV_CMODEL) SOC=$(SOC) BOARD=$(BOARD) CORE=$(CORE) ARCH_EXT=$(ARCH_EXT) DOWNLOAD=$(DOWNLOAD) STDCLIB=$(STDCLIB) SMP=$(SMP) BOOT_HARTID=$(BOOT_HARTID)

showflags:
	@$(ECHO) TARGET: $(TARGET)
	@$(ECHO) NUCLEI_SDK_ROOT: $(NUCLEI_SDK_ROOT)
	@$(ECHO) NUCLEI_SDK_NMSIS: $(NUCLEI_SDK_NMSIS)
	@$(ECHO) OPENOCD_CFG: $(OPENOCD_CFG)
	@$(ECHO) LINKER_SCRIPT: $(LINKER_SCRIPT)
	@$(ECHO) OUTDIR: $(OUTDIR)
	@$(ECHO) ASMFLAGS: $(ASMFLAGS)
	@$(ECHO) CFLAGS: $(CFLAGS)
	@$(ECHO) CXXFLAGS: $(CXXFLAGS)
	@$(ECHO) LDFLAGS: $(LDFLAGS)
	@$(ECHO) CC: $(CC)
	@$(ECHO) CXX: $(CXX)
	@$(ECHO) GDB: $(GDB)

showtoolver:
	@$(ECHO) Show $(CC) version
	@$(CC) -v
	@$(ECHO) Show $(OPENOCD) version
	@$(OPENOCD) -v
	@$(ECHO) Show $(QEMU) version
	-@$(QEMU) --version

help:
	@$(ECHO) "Nuclei N/NX-series RISC-V Embedded Processor Software Development Kit "
	@$(ECHO) "== For detailed user guide, please check https://doc.nucleisys.com/nuclei_sdk/"
	@$(ECHO) "== Make variables used in Nuclei SDK =="
	@$(ECHO) "SOC:         Select SoC built in Nuclei SDK, will select evalsoc by default"
	@$(ECHO) "BOARD:       Select SoC's Board built in Nuclei SDK, will select nuclei_fpga_eval by default"
	@$(ECHO) "CORE:        Not required for all SoCs, currently only evalsoc require it, n307fd by default"
	@$(ECHO) "ARCH_EXT:    Not required for all SoCs, currently only evalsoc require it, such as ARCH_EXT=_zba_zbb_zbc_zbs_xxldspn3x, means B and Nuclei DSP(p v0.5.3) with N1/N2/N3 extension, please use >= gcc 13"
	@$(ECHO) "DOWNLOAD:    Not required for all SoCs, use ilm by default, optional flashxip/ilm/flash/ddr"
	@$(ECHO) "V:           V=1 verbose make, will print more information, by default V=0"
	@$(ECHO) "O:           Set the output directory for build generated objects and targets, such as O=build, by default O is EMPTY, which means targets are generated in current directory and objects are grouped in _obj_sdk and _obj_app directories"
	@$(ECHO) "== How to Use with Make =="
	@$(ECHO) "1. Build Application:"
	@$(ECHO) "all [PROGRAM=flash/flashxip/ilm/ddr]"
	@$(ECHO) "   Build a software program to load with the debugger."
	@$(ECHO) "2. Upload Application to Board using OpenOCD and GDB:"
	@$(ECHO) "upload [PROGRAM=flash/flashxip/ilm/ddr]"
	@$(ECHO) "   Launch OpenOCD to flash your program to the on-board Flash."
	@$(ECHO) "3:(Option 1) Debug Application using OpenOCD and GDB"
	@$(ECHO) "  3.1: run_openocd"
	@$(ECHO) "  3.2: run_gdb [PROGRAM=flash/flashxip/ilm/ddr]"
	@$(ECHO) "   Step 1: Launch OpenOCD for Debugger connection: make run_openocd"
	@$(ECHO) "   Step 2: Launch GDB to connect openocd server, you can set breakpoints using gdb and debug it."
	@$(ECHO) "           If you want to load your application, you need to run load in gdb command terminal"
	@$(ECHO) "           to load your program, then use gdb to debug it."
	@$(ECHO) "3:(Option 2) Debug Application using OpenOCD and GDB"
	@$(ECHO) "debug [PROGRAM=flash/flashxip/ilm/ddr]"
	@$(ECHO) "   Launch GDB and OpenOCD to debug your application on-board, you can set breakpoints using gdb and debug it."
	@$(ECHO) "           If you want to load your application, you need to run load in gdb command terminal"
	@$(ECHO) "           to load your program, then use gdb to debug it."
	@$(ECHO) ""
	@$(ECHO) "== Example Usage =="
	@$(ECHO) "1. cd <NUCLEI_SDK_ROOT>/application/helloworld"
	@$(ECHO) "2. Build for ILM download mode: make DOWNLOAD=ilm all"
	@$(ECHO) "3. Download application to board: make DOWNLOAD=ilm upload"
	@$(ECHO) "4.(Option 1) Debug application:"
	@$(ECHO) "   4.1 Terminal One: make DOWNLOAD=ilm run_openocd"
	@$(ECHO) "   4.2 Terminal Two: make DOWNLOAD=ilm run_gdb"
	@$(ECHO) "4.(Option 2) Debug application: make DOWNLOAD=ilm debug"
	@$(ECHO) ""

$(TARGET_ELF): $(ALL_OBJS)
	$(TRACE_LINK)
	$(Q)$(CC) $(CFLAGS) $(ALL_OBJS) -o $@ $(LDFLAGS)
	$(Q)$(SIZE) $@

$(SDK_ASM_OBJS): $(SDK_OBJ_OUTDIR)/%.o: $(NUCLEI_SDK_ROOT)/% $(COMMON_PREREQS)
	$(TRACE_ASSEMBLE)
	$(DIR_GUARD)
	$(Q)$(CC) $(ASMFLAGS) $(MKDEP_OPT) -c -o $@ $<

$(SDK_C_OBJS): $(SDK_OBJ_OUTDIR)/%.o: $(NUCLEI_SDK_ROOT)/% $(COMMON_PREREQS)
	$(TRACE_COMPILE)
	$(DIR_GUARD)
	$(Q)$(CC) $(CFLAGS) $(MKDEP_OPT) -c -o $@ $<

$(SDK_CXX_OBJS): $(SDK_OBJ_OUTDIR)/%.o: $(NUCLEI_SDK_ROOT)/% $(COMMON_PREREQS)
	$(TRACE_COMPILE)
	$(DIR_GUARD)
	$(Q)$(CXX) $(CXXFLAGS) $(MKDEP_OPT) -c -o $@ $<

$(filter-out $(LOCAL_ASM_OBJS_ESC),$(LOCAL_ASM_OBJS)): $(APP_OBJ_OUTDIR)/%.o: % $(COMMON_PREREQS)
	$(TRACE_ASSEMBLE)
	$(DIR_GUARD)
	$(Q)$(CC) $(ASMFLAGS) $(MKDEP_OPT) -c -o $@ $<

$(filter-out $(LOCAL_C_OBJS_ESC),$(LOCAL_C_OBJS)): $(APP_OBJ_OUTDIR)/%.o: % $(COMMON_PREREQS)
	$(TRACE_COMPILE)
	$(DIR_GUARD)
	$(Q)$(CC) $(CFLAGS) $(MKDEP_OPT) -c -o $@ $<

$(filter-out $(LOCAL_CXX_OBJS_ESC),$(LOCAL_CXX_OBJS)): $(APP_OBJ_OUTDIR)/%.o: % $(COMMON_PREREQS)
	$(TRACE_COMPILE)
	$(DIR_GUARD)
	$(Q)$(CXX) $(CXXFLAGS) $(MKDEP_OPT) -c -o $@ $<

## Explicit rules for local objects whose sources are outside the
## application directory (referenced via ../ or absolute paths)
define LOCAL_ASM_OBJ_RULE
$(call SANITIZED_OBJ,$(1)): $(basename $(subst $(APP_OBJ_OUTDIR)/,,$(1))) $(COMMON_PREREQS)
	$$(TRACE_ASSEMBLE)
	$$(DIR_GUARD)
	$$(Q)$$(CC) $$(ASMFLAGS) $$(MKDEP_OPT) -c -o $$@ $$<
endef

define LOCAL_C_OBJ_RULE
$(call SANITIZED_OBJ,$(1)): $(basename $(subst $(APP_OBJ_OUTDIR)/,,$(1))) $(COMMON_PREREQS)
	$$(TRACE_COMPILE)
	$$(DIR_GUARD)
	$$(Q)$$(CC) $$(CFLAGS) $$(MKDEP_OPT) -c -o $$@ $$<
endef

define LOCAL_CXX_OBJ_RULE
$(call SANITIZED_OBJ,$(1)): $(basename $(subst $(APP_OBJ_OUTDIR)/,,$(1))) $(COMMON_PREREQS)
	$$(TRACE_COMPILE)
	$$(DIR_GUARD)
	$$(Q)$$(CXX) $$(CXXFLAGS) $$(MKDEP_OPT) -c -o $$@ $$<
endef

$(foreach obj,$(LOCAL_ASM_OBJS_ESC),$(eval $(call LOCAL_ASM_OBJ_RULE,$(obj))))
$(foreach obj,$(LOCAL_C_OBJS_ESC),$(eval $(call LOCAL_C_OBJ_RULE,$(obj))))
$(foreach obj,$(LOCAL_CXX_OBJS_ESC),$(eval $(call LOCAL_CXX_OBJ_RULE,$(obj))))

dasm: $(TARGET_ELF)
	-$(OBJDUMP) -S -d -M no-aliases $< > $(APP_TARGET_DUMP)
	-$(OBJDUMP) -d -M no-aliases $< > $(APP_TARGET_DASM)
	-$(OBJCOPY) $< -O ihex $(APP_TARGET_HEX)
ifeq ($(TOOLCHAIN),nuclei_gnu)
	-$(OBJCOPY) $< -O srec $(APP_TARGET_SREC)
	-$(OBJCOPY) $< -O verilog $(APP_TARGET_VERILOG)
endif

bin: $(TARGET_ELF)
	$(OBJCOPY) $< -O binary $(APP_TARGET_BIN)

size: $(TARGET_ELF)
	$(Q)$(SIZE) $<

upload: $(TARGET_ELF)
	@$(ECHO) "Download and run $<"
	$(GDB) -ex "set remotetimeout 240" -ex "target remote $(GDBREMOTE)" $(GDB_UPLOAD_ARGS) $(GDB_UPLOAD_CMDS)

run_openocd:
	@$(ECHO) "Start openocd server"
	$(OPENOCD) $(OPENOCD_PORT_ARGS) $(OPENOCD_ARGS)

run_gdb: $(TARGET_ELF)
	@$(ECHO) "Run gdb to connect openocd server and debug"
	$(GDB) $< $(GDB_ARGS) $(GDB_CMDS)

debug: $(TARGET_ELF)
	@$(ECHO) "Download and debug $<"
	$(GDB) $< -ex "set remotetimeout 240" -ex "target remote $(GDBREMOTE)"

# just for evalsoc purpose
# https://doc.nucleisys.com/nuclei_tools/qemu/intro.html
run_qemu: $(TARGET_ELF)
	@$(ECHO) "Run program $< on $(QEMU)"
	$(QEMU) -M $(QEMU_MACHINE) -cpu $(QEMU_CPU) $(QEMU_OPT) -nodefaults -nographic -serial stdio $(QEMU_ELF_OPT) $<

# just for evalsoc purpose
run_qemu_debug: $(TARGET_ELF)
	@$(ECHO) "Run program $< on $(QEMU), and waiting for gdb connection on port $(GDB_PORT)"
	@$(ECHO) "Then you can open a new terminal in the same directory and run make target: run_gdb to connect to this gdb connection"
	$(QEMU) -M $(QEMU_MACHINE) -cpu $(QEMU_CPU) $(QEMU_OPT) -nodefaults -nographic -serial stdio $(QEMU_ELF_OPT) $< -S -gdb tcp::$(GDB_PORT)

# just for evalsoc purpose using xlmodel
# https://doc.nucleisys.com/nuclei_tools/xlmodel/intro.html
run_xlmodel: $(TARGET_ELF)
	@$(ECHO) "Run program $< on $(XLMODEL)"
	$(XLMODEL) $(XLMODEL_OPT) $(XLMODEL_EXTOPT) $<

# just works on evalsoc purpose, experimental support
run_xlspike: $(TARGET_ELF)
	@$(ECHO) "Run program $< on $(XLSPIKE)"
	$(XLSPIKE) $(XLSPIKE_OPT) --isa $(XLSPIKE_ARCH) $<

run_xlspike_rbb: $(TARGET_ELF)
	@$(ECHO) "Run program $< on $(XLSPIKE), and waiting for remote bitbang connection on port $(RBB_PORT)"
	@$(ECHO) "Then you need open a new terminal in the same directory and run make target: run_xlspike_openocd to connect to this remote bitbang connection"
	$(XLSPIKE) $(XLSPIKE_OPT) --rbb-port=$(RBB_PORT) -H --isa $(XLSPIKE_ARCH) $<

run_xlspike_openocd:
	@$(ECHO) "Run openocd to connect to remote bitbang connection"
	@$(ECHO) "Then you can open a new terminal in the same directory and run make target: run_gdb to connect to this gdb connection"
	$(OPENOCD) $(OPENOCD_PORT_ARGS) -f $(OPENOCD_XLSPIKE_CFG)

clean:
	@$(ECHO) "Clean all build objects"
	$(Q)$(RM) $(REAL_CLEAN_OBJS)
	$(Q)-$(RMD) $(subst /,$(PS),$(SDK_OBJ_OUTDIR) $(APP_OBJ_OUTDIR))
